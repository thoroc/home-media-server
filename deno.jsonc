{
  "tasks": {
    "dev": "deno run --watch cli.ts",
    "cli": "deno run -A cli.ts"
  },
  "imports": {
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.0.0-rc.7",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "@json-types/compose": "npm:@json-types/compose@^0.8.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "docker-compose": "npm:docker-compose@^1.1.0"
  },
  "lint": {
    "include": [
      "src/",
      "hms.ts",
      "hms.tsx"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": [
      "src/",
      "hms.ts",
      "hms.tsx"
    ]
  },
  "workspace": [
    "src/cli",
    "src/commands",
    "src/services",
    "src/core"
  ]
}